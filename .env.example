# ─────────────────────────────────────────────────────────────────────────────
# DexHub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://dexhub.yourdomain.com
NEXT_PUBLIC_API_URL=https://dexhub.yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=dexhub
POSTGRES_USER=dexhub
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://dexhub:change-me-strong-password@postgres:5432/dexhub

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://dexhub.yourdomain.com

# ─── WebAuthn / Passkeys ──────────────────────────────────────────────────────
# RP_ID must match the domain (no scheme, no port) where DexHub is served
WEBAUTHN_RP_NAME=DexHub
WEBAUTHN_RP_ID=dexhub.yourdomain.com
WEBAUTHN_ORIGIN=https://dexhub.yourdomain.com

# ─── Backup ───────────────────────────────────────────────────────────────────
# Directory where backup files are stored (mounted as Docker volume in compose)
BACKUP_DIR=/data/backups

# AES-256-GCM key for encrypting backups (optional — plain JSON if unset)
# Generate with: openssl rand -base64 32
# IMPORTANT: losing this key makes encrypted backups unrecoverable
BACKUP_ENCRYPTION_KEY=

# ─── Recovery Code Encryption ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting recovery codes stored in the database.
# Required — the API will not start without this variable.
# Generate with: openssl rand -hex 32
# IMPORTANT: if you rotate this key, the first admin view of each user's recovery
# code will transparently re-encrypt it. No manual action needed.
# NEVER lose this key while encrypted codes are in the database.
RECOVERY_CODE_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# ─── Emergency Access ─────────────────────────────────────────────────────────
# One-time-use token for locked-out recovery (passkey lost). Optional.
# Generate with: openssl rand -hex 32
# ROTATE OR REMOVE after use — the controller warns you to do so.
# EMERGENCY_ACCESS_TOKEN=

# ─── Mail / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DexHub" <noreply@dexhub.it>
ADMIN_EMAIL=admin@yourdomain.com

# ─── Redis (optional, reserved for future caching layer) ──────────────────────
# REDIS_PASSWORD=change-me-redis-password
# REDIS_URL=redis://:change-me-redis-password@redis:6379
